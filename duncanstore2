<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Duncan Swim Spirit Gear Store</title>
<style>
:root { --red:#d71920; --black:#080808; --gray:#f3f3f3; }
* { box-sizing:border-box; }
body { margin:0; font-family:Arial,Helvetica,sans-serif; background:#f5f5f5; color:#111; }
header { background:linear-gradient(135deg,#050505 0%,#171717 70%,#d71920 70%); color:#fff; padding:28px 20px 24px; }
.wrap { max-width:1200px; margin:auto; }
.brand { display:flex; align-items:center; gap:16px; }
.logo { width:76px; height:76px; border:4px solid var(--red); display:grid; place-items:center; font-weight:900; font-size:52px; line-height:1; color:#fff; background:#111; }
h1 { margin:0; font-size:clamp(30px,5vw,54px); letter-spacing:1px; }
.tag { margin:5px 0 0; font-size:15px; letter-spacing:2px; text-transform:uppercase; }
.notice { background:#fff; border-left:6px solid var(--red); padding:15px 18px; margin:22px 0; font-weight:700; }
.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; }
.card { background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,.10); display:flex; flex-direction:column; }
.card img { width:100%; aspect-ratio:1/1; object-fit:contain; background:#fff; }
.card-body { padding:14px; display:flex; flex-direction:column; gap:9px; flex:1; }
.card h3 { margin:0; font-size:17px; }
.price { color:var(--red); font-size:20px; font-weight:900; }
.name-option { display:flex; align-items:center; gap:8px; font-size:14px; font-weight:700; } .name-option input { width:auto; }\nselect,input { width:100%; padding:10px; border:1px solid #ccc; border-radius:7px; font-size:14px; }
button { border:0; border-radius:8px; padding:11px 14px; font-weight:900; cursor:pointer; }
.add { background:var(--black); color:#fff; }
.add:hover { background:var(--red); }
section { padding:25px 20px; }
.cart { background:#fff; margin-top:28px; padding:22px; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,.10); }
.cart-row { display:grid; grid-template-columns:1fr auto auto; gap:12px; align-items:center; padding:10px 0; border-bottom:1px solid #eee; }
.total { text-align:right; font-size:23px; font-weight:900; margin-top:15px; }
.formgrid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.full { grid-column:1/-1; }
.order { background:var(--red); color:#fff; width:100%; margin-top:14px; font-size:17px; }
.small { font-size:12px; color:#666; }
footer { background:#080808; color:#fff; text-align:center; padding:25px; margin-top:35px; }
@media(max-width:650px) { .formgrid { grid-template-columns:1fr; } .full { grid-column:auto; } .cart-row { grid-template-columns:1fr; } }
</style>
</head>
<body>
<header>
<div class="wrap">
  <div class="brand">
    <div class="logo">D</div>
    <div><h1>DUNCAN SWIM</h1><div class="tag">2026–2027 Spirit Gear Store</div></div>
  </div>
</div>
</header>

<section>
<div class="wrap">
  <div class="notice">SHOW YOUR TEAM SPIRIT! Every design is available in Short Sleeve, Long Sleeve, Crew Neck, Hoodie, and Dry Fit Short Sleeve.</div>
  <div class="grid" id="products"></div>

  <div class="cart">
    <h2>🛒 Your Order</h2>
    <div id="cart"></div>
    <div class="total" id="total">$0.00</div>

    <h2 style="margin-top:28px;">Customer Information</h2>
    <div class="formgrid">
      <div><label>Name<br><input id="customerName" placeholder="First and last name"></label></div>
      <div><label>Phone<br><input id="phone" placeholder="Phone number"></label></div>
      <div class="full"><label>Email<br><input id="email" type="email" placeholder="Email address"></label></div>
      <div class="full"><label>Notes / Special Instructions<br><input id="notes" placeholder="Optional"></label></div>
    </div>
    <button class="order" onclick="submitOrder()">SUBMIT ORDER</button>
    <p class="small">Orders are sent to the Duncan Swim shared Google Sheet when you click SUBMIT ORDER.</p>
  </div>
</div>
</section>

<footer>DUNCAN SWIM • SUPPORT THE TEAM • 2026–2027</footer>

<script>
const products = [{"name":"Black Towel","price":25,"image":"data:image/webp;base64,"},{"name":"Red Swim Strokes T-Shirt","price":15,"image":"data:image/webp;base64,"},{"name":"Gray Duncan Swim Block T-Shirt","price":15,"image":"data:image/webp;base64,"},{"name":"White Duncan Swim T-Shirt","price":25,"image":"data:image/webp;base64,"},{"name":"Red Duncan Swim T-Shirt","price":25,"image":"data:image/webp;base64,"},{"name":"Gray Duncan Swimming T-Shirt","price":25,"image":"data:image/webp;base64,"},{"name":"Chlorine, Sweat & Tears T-Shirt","price":25,"image":"data:image/webp;base64,"},{"name":"Black Duncan Swim T-Shirt","price":25,"image":"data:image/webp;base64,"},{"name":"Black Duncan Swim Sweatpants","price":30,"image":"data:image/webp;base64,"}];

const styles = [
  {name:"Short Sleeve", price:15},
  {name:"Long Sleeve", price:18},
  {name:"Crew Neck", price:25},
  {name:"Hoodie", price:30},
  {name:"Dry Fit Short Sleeve", price:20}
];
function priceLabel(n) { return n > 0 ? money(n) : "PRICE TBD"; }

let cart = JSON.parse(localStorage.getItem("duncanSwimCart") || "[]");

function money(n) { return "$" + n.toFixed(2); }

function renderProducts() {
  const el = document.getElementById("products");
  el.innerHTML = products.map((p,i) => `
    <article class="card">
      <img src="${p.image}" alt="${p.name}">
      <div class="card-body">
        <h3>${p.name}</h3>

        ${p.name === "Black Towel" ? `
        <input id="style-${i}" value="No Style" readonly>
        <div class="price" id="price-${i}">${money(25)}</div>
        ` : p.name === "Black Duncan Swim Sweatpants" ? `
        <div class="price" id="price-${i}">${money(p.price)}</div>
        ` : `
        <select id="style-${i}" onchange="updateStylePrice(${i})">
          <option value="">Select style</option>
          <option value="0">Short Sleeve — $15.00</option>
          <option value="1">Long Sleeve — $18.00</option>
          <option value="2">Crew Neck — $25.00</option>
          <option value="3">Hoodie — $30.00</option>
          <option value="4">Dry Fit Short Sleeve — $20.00</option>
        </select>
        <div class="price" id="price-${i}">Select a style</div>
        `}

        <select id="size-${i}">
          <option value="">Select size</option>
          <option>YS</option><option>YM</option><option>YL</option>
          <option>AS</option><option>AM</option><option>AL</option><option>AXL</option><option>2XL</option><option>3XL</option>
        </select>

        ${p.name !== "Black Towel" && p.name !== "Black Duncan Swim Sweatpants" ? `
        <select id="nameOption-${i}">
          <option value="0">No Name</option>
          <option value="3">Add Name on Back — +$3.00</option>
        </select>
        ` : ""}

        <input id="qty-${i}" type="number" min="1" value="1">
        <button class="add" onclick="addToCart(${i})">ADD TO ORDER</button>
      </div>
    </article>`).join("");
}

function updateStylePrice(i) {
  const idx = document.getElementById("style-"+i).value;
  const priceEl = document.getElementById("price-"+i);
  priceEl.textContent = idx === "" ? "Select a style" : priceLabel(styles[Number(idx)].price);
}

function addToCart(i) {
  const p = products[i];
  const isTowel = p.name === "Black Towel";
  const isJoggers = p.name === "Black Duncan Swim Sweatpants";

  let basePrice;
  let styleName;

  if (isTowel) {
    basePrice = 25;
    styleName = "No Style";
  } else if (isJoggers) {
    basePrice = p.price;
    styleName = "No Style";
  } else {
    const styleIndex = document.getElementById("style-"+i).value;
    if (styleIndex === "") {
      alert("Please select a style.");
      return;
    }
    const s = styles[Number(styleIndex)];
    basePrice = s.price;
    styleName = s.name;
  }

  const size = document.getElementById("size-"+i).value;
  if (!size) {
    alert("Please select a size.");
    return;
  }

  const qty = Math.max(1, parseInt(document.getElementById("qty-"+i).value || "1"));

  const nameSelect = document.getElementById("nameOption-"+i);
  const nameAdded = nameSelect ? nameSelect.value === "3" : false;
  const namePrice = nameAdded ? 3 : 0;

  cart.push({
    name: p.name,
    style: styleName,
    nameAdded,
    price: basePrice + namePrice,
    size,
    qty
  });

  localStorage.setItem("duncanSwimCart", JSON.stringify(cart));
  renderCart();
}

function removeItem(i) {
  cart.splice(i,1);
  localStorage.setItem("duncanSwimCart", JSON.stringify(cart));
  renderCart();
}

function renderCart() {
  const el = document.getElementById("cart");
  if (!cart.length) {
    el.innerHTML = "<p>Your order is empty.</p>";
  } else {
    el.innerHTML = cart.map((x,i) => `
      <div class="cart-row">
        <div><b>${x.name}</b><br>Style: ${x.style}${x.nameAdded ? " • Name on Back: +$3.00" : ""} • Size: ${x.size} • Qty: ${x.qty}</div>
        <div>${money(x.price*x.qty)}</div>
        <button onclick="removeItem(${i})">Remove</button>
      </div>`).join("");
  }
  const total = cart.reduce((s,x)=>s+x.price*x.qty,0);
  document.getElementById("total").textContent = money(total);
}

const GOOGLE_SHEETS_URL = "https://script.google.com/macros/s/AKfycbxHjG673NW42pFlMC_mKmV5Th5quaYU42TyS6u1lII0rHtHsopxQ_BbnwYrD8VBycet/exec";

async function submitOrder() {
  if (!cart.length) return alert("Please add at least one item to your order.");
  const name = document.getElementById("customerName").value.trim();
  const phone = document.getElementById("phone").value.trim();
  const email = document.getElementById("email").value.trim();
  const notes = document.getElementById("notes").value.trim();
  if (!name || !phone) return alert("Please enter your name and phone number.");

  const total = cart.reduce((s,x)=>s+x.price*x.qty,0);
  const orderNumber = "DS-" + Date.now();
  const orderDate = new Date().toLocaleString();

  const order = {
    orderNumber,
    date: orderDate,
    name, phone, email, notes,
    items:[...cart],
    total
  };

  // Keep a local backup as well.
  const orders = JSON.parse(localStorage.getItem("duncanSwimOrders") || "[]");
  orders.push(order);
  localStorage.setItem("duncanSwimOrders", JSON.stringify(orders));

  try {
    // Send one spreadsheet row for each item in the cart.
    // text/plain avoids a browser CORS preflight; Apps Script still parses the JSON body.
    for (const item of cart) {
      const payload = {
        orderNumber: orderNumber,
        date: orderDate,
        customerName: name,
        phone: phone,
        email: email,
        product: item.name || "",
        style: item.style || "",
        size: item.size || "",
        nameOnBack: item.nameAdded ? "Yes (+$3.00)" : "No",
        quantity: item.qty || 1,
        price: item.price || 0,
        total: total,
        notes: notes
      };

      await fetch(GOOGLE_SHEETS_URL, {
        method: "POST",
        mode: "no-cors",
        headers: {"Content-Type": "text/plain;charset=utf-8"},
        body: JSON.stringify(payload)
      });
    }

    alert("Order submitted! Order #: " + orderNumber + "\nTotal: " + money(total));
    cart=[];
    localStorage.setItem("duncanSwimCart","[]");
    renderCart();
  } catch (error) {
    alert("Your order was saved on this device, but it could not be sent to the shared order sheet. Please try submitting again.\n\nError: " + error.message);
  }
}
renderProducts();
renderCart();
</script>
</body>
</html>
